include ../badges/dates.pug
include ../badges/strings.pug
//- 7B
article.card(id='7B' data-desktop-src=pathCard + '7B-desktop-preview.gif' data-mobile-src=pathCard + '7B-desktop-preview.gif')
  .card__glows
  .card__thumbnail
    img.card__gif(loading="eager" src=pathCard + '7B-desktop-preview.gif' alt=title7B)
    img.card__img.hover(loading="eager" src='assets/img/hoverAlt.svg' alt=hover)
  h3.card__title #{title7B}
  .card__header
    .card__list
      ul
        +design-badge
        +ps-badge
    .card__list
      ul
        +2024
  .card__description
    p #{desc7B}
  .card__footer
    a.widget__link.card__button(href=url7B target='_blank' aria-label=desc7B)
      span.card__link #{btn7B}
      +svg-arrow
    .card__bookmark
      button