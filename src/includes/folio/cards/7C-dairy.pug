include ../badges/dates.pug
include ../badges/strings.pug
//- 7C
article.card(id='7C' data-desktop-src=pathCard + '7C-desktop-preview.gif' data-mobile-src=pathCard + '7C-desktop-preview.gif')
  .card__glows
  .card__thumbnail
    img.card__gif(loading="lazy" src=pathCard + '7C-desktop-preview.gif' alt=title7C)
    img.card__img.hover(loading="lazy" src='assets/img/hoverAlt.svg' alt=hover)
  h3.card__title #{title7C}
  .card__header
    .card__list
      ul
        +design-badge
        +ps-badge
    .card__list
      ul
        +2025
  .card__description
    p #{desc7C}
  .card__footer
    a.widget__link.card__button(href=url7C target='_blank' aria-label=desc7C)
      span.card__link #{btn7C}
      +svg-arrow
    .card__bookmark
      button